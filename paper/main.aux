\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Default vs.\ best-across-the-8-settings-tried hierboost, per locus. ``Best dist.\ (oracle)'' selects the setting closest to the known causal SNP -- a retrospective upper bound on localization potential, NOT a valid tuning procedure (Sec.\nobreakspace  {}\ref  {sec:sensitivity}). ``Best-acc.\ dist.'' instead selects whichever setting has the single highest CV accuracy -- the only criterion a practitioner could use without already knowing the causal SNP.}}{11}{table.2}\protected@file@percent }
\newlabel{tab:sensitivity}{{2}{11}{Default vs.\ best-across-the-8-settings-tried hierboost, per locus. ``Best dist.\ (oracle)'' selects the setting closest to the known causal SNP -- a retrospective upper bound on localization potential, NOT a valid tuning procedure (Sec.~\ref {sec:sensitivity}). ``Best-acc.\ dist.'' instead selects whichever setting has the single highest CV accuracy -- the only criterion a practitioner could use without already knowing the causal SNP}{table.2}{}}
