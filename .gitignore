# Virtual environments (main env installs into system python3; these are the
# JAX/genomics/haxby isolated envs described in README.md)
.venv*/

# Python bytecode / build / test caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Downloaded raw data caches -- each regenerated by that domain's own
# fetch.py/download_prices.py/build_dataset.py, too large for git (several
# exceed GitHub's 100MB hard limit, e.g. predom_airquality's EPA CSVs).
predom_airquality/data/
predom_solar/data/
predom_homeprice/data/
predom_traffic/data/
predom_snowpack/data/
predom_macro/data/
predom_tcga/data/
streamflow_delaware/data/
uk_weather/data/
earthquake_japan/data/
state_econ/data/
# m6_backtest/data/ mixes small source/config (rps_ir_reference.py,
# symbols.json, sectors.json, asset_info.json) with two large downloaded
# reference files from the official M6 repo -- ignore only the latter.
m6_backtest/data/submissions.csv
m6_backtest/data/summary_leaderboard.xlsx

# 1000 Genomes / GWAS remote-fetch index files (re-fetched by
# genomics_1kg_fetch.py against the public FTP/HTTP endpoints)
*.vcf.gz
*.vcf.gz.tbi
*.results.gz.tbi

# OS
.DS_Store
